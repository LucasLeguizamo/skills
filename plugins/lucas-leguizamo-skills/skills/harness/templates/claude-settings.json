{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && ./scripts/check-api-docs.sh >/dev/null || exit 2",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
